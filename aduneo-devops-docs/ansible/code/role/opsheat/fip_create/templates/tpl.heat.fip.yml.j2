---

heat_template_version: 2018-08-31
description: >
  Tpl@(Ops, Heat) to create:
  -  1 FIP (aka Floating IP)

# resource to create
resources:
{% if lobj.provided is not defined %}
  ## Floating IP
  fip_{{ lobj.id }}:
    type: OS::Neutron::FloatingIP
    properties:
      floating_network:     {{ lobj.network.src.name }}
{%endif%}
  ## Floatig IP Association
  floating_ip_assoc:
    type: OS::Neutron::FloatingIPAssociation
    properties:
      port_id:       {{ lvm_port_id.stdout }}
{% if lobj.provided is defined %}
      floatingip_id: {{ lfip_ops_id.stdout }}
{%else%}
      floatingip_id: { get_resource: fip_{{ lobj.id }} }
{%endif%}



# openstack floating ip list
